# Keep the POSIX launcher usable after a Windows checkout.
/codast.sh text eol=lf

# Vendored files are byte-exact upstream copies; index.html pins some with integrity hashes,
# so a CRLF checkout would make the browser refuse them.
/app/web/static/vendor/** -text

# Defense in depth for git archive; do not package local runtime data.
/.local export-ignore
/.vscode export-ignore
/.vscode/** export-ignore
/.scannerwork export-ignore
/work export-ignore
/outputs export-ignore
/workspaces export-ignore
/backups export-ignore
/dumps export-ignore
/exports export-ignore
/.codex export-ignore
/.claude export-ignore
/.harness export-ignore
**/.codast-documents export-ignore
.env export-ignore
.env.* export-ignore
*.sqlite* export-ignore
*.db export-ignore
*.db-* export-ignore
*.dump export-ignore
*.dump.sql export-ignore
*.data.sql export-ignore
auth.json export-ignore
credentials.json export-ignore
secrets.json export-ignore
settings.local.json export-ignore
connections.local.json export-ignore

# Local-only internal documents
/docs/internal export-ignore
/docs/internal/** export-ignore

# Keep private settings and runtime artifacts out of exported archives.
*.local.json export-ignore
*.local.toml export-ignore
*.local.yaml export-ignore
*.local.yml export-ignore
*.db.bak export-ignore
*.log export-ignore

# Retain public configuration templates.
.env.example -export-ignore
.env.template -export-ignore
.env.sonar.example -export-ignore
/.githooks/* text eol=lf
